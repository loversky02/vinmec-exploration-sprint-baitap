vinmec.vinunquant.com {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
	}
	@slides_root path /slides
	redir @slides_root /slides/ permanent
	handle_path /slides/* {
		root * /opt/vinmec-presentation/current
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8770
	}
}
